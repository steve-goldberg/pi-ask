{
  "schemaVersion": 1,
  "name": "pi-ralph",
  "description": "Pi-native Ralph-style feature loop implemented as a project-local pi extension with a long-lived controller, fresh coder attempts, and read-only testers.",
  "roles": {
    "coder": {
      "prompt": ".pi/ralph/prompts/coder.md",
      "mode": "write",
      "description": "Fresh coding worker. Can edit code but cannot run acceptance gates or mark pass/fail."
    },
    "backendTester": {
      "prompt": ".pi/ralph/prompts/tester-backend.md",
      "mode": "read-only",
      "description": "Read-only tester for non-browser verification and feature-specific backend/product behavior checks."
    },
    "playwrightTester": {
      "prompt": ".pi/ralph/prompts/tester-playwright.md",
      "mode": "read-only",
      "skills": [
        "playwright-cli"
      ],
      "description": "Read-only browser tester for end-to-end and UI acceptance checks."
    }
  },
  "testTypes": {
    "lint": {
      "runner": "command",
      "command": "npm run lint",
      "description": "Static lint gate."
    },
    "typecheck": {
      "runner": "command",
      "command": "npm run typecheck",
      "description": "TypeScript compile/type gate."
    },
    "unit": {
      "runner": "command",
      "command": "npm run test:unit",
      "description": "Unit-test gate."
    },
    "backend": {
      "runner": "agent",
      "role": "backendTester",
      "description": "Read-only tester driven by a feature-specific backend/product test spec."
    },
    "playwright": {
      "runner": "agent",
      "role": "playwrightTester",
      "description": "Read-only browser tester driven by a feature-specific Playwright/e2e test spec."
    }
  },
  "sections": {
    "grillMe": {
      "title": "Interactive /grill-me questionnaire extension",
      "status": "planned",
      "priority": "high",
      "goal": "Create a reusable pi-native interview/questionnaire extension that asks one question at a time, persists draft answers to a temp JSON file, lets the user review and edit answers quickly in the TUI, and on submit sends structured Q/A JSON back into the active pi session as a normal user message.",
      "scope": {
        "part1": "Build the standalone reusable questionnaire engine and expose it through /grill-me with a built-in default question set and zero required arguments.",
        "part2": "Wire the same questionnaire engine into the future clarification workflow so feature planning can generate questions, collect answers, and write clarifications back into PRD.md and per-feature markdown files."
      },
      "decisions": {
        "command": "/grill-me",
        "commandArgs": "none",
        "questionSourceV1": "built-in default questionnaire bundled with the extension",
        "questionSchema": {
          "fields": [
            "id",
            "question",
            "multiline",
            "recommendation"
          ],
          "notes": [
            "multiline is allowed in schema for forward compatibility but ignored in v1 UI",
            "recommendation is optional and only shown when present"
          ]
        },
        "answerBehavior": {
          "singleLineOnly": true,
          "enter": "save current answer and advance to next question",
          "shiftTab": "go to previous question",
          "escape": "close questionnaire and keep current temp draft",
          "leftRight": "normal text editing"
        },
        "reviewBehavior": {
          "mode": "review list with native up/down selection",
          "answerRows": "selecting an answer row with Enter returns to that question for editing",
          "submitAction": "submit appears as a selectable review action instead of a custom hotkey",
          "cancelAction": "cancel appears as a selectable review action and also remains available via Escape"
        },
        "draftStorage": {
          "path": ".pi/tmp/grill-me.json",
          "overwriteOnStart": true,
          "updateDuringSession": true,
          "keepOnCancel": true,
          "keepOnSubmit": false
        },
        "submitBehavior": {
          "mode": "send a wrapped JSON payload back into the active pi session as a normal user message",
          "wrapper": "Here are my answers from /grill-me:",
          "resultShape": {
            "title": "string",
            "responses": [
              {
                "id": "string",
                "question": "string",
                "answer": "string"
              }
            ]
          }
        },
        "documentNaming": {
          "topLevel": "PRD.md",
          "perFeature": "001-name.md style feature files"
        }
      },
      "defaultQuestionsV1": {
        "title": "Design Clarification",
        "questions": [
          {
            "id": "problem",
            "question": "What are we building, in one concrete sentence?",
            "multiline": false
          },
          {
            "id": "user",
            "question": "Who is the primary user or operator of this system?",
            "multiline": false
          },
          {
            "id": "pain",
            "question": "What problem or pain point does this solve for them?",
            "multiline": false
          },
          {
            "id": "scope",
            "question": "What is definitely in scope for the first version?",
            "multiline": false
          },
          {
            "id": "out_of_scope",
            "question": "What is explicitly out of scope for now?",
            "multiline": false
          },
          {
            "id": "constraints",
            "question": "What non-negotiable constraints, rules, or preferences must be respected?",
            "multiline": false
          },
          {
            "id": "stack",
            "question": "What stack or platform decisions are already fixed?",
            "multiline": false
          },
          {
            "id": "risks",
            "question": "What are the biggest unknowns or risks right now?",
            "multiline": false
          },
          {
            "id": "done",
            "question": "What does done look like for this plan?",
            "multiline": false
          },
          {
            "id": "first_step",
            "question": "What should happen first once implementation begins?",
            "multiline": false
          }
        ]
      },
      "filesPlanned": [
        ".pi/extensions/grill-me/index.ts",
        ".pi/extensions/grill-me/types.ts",
        ".pi/extensions/grill-me/storage.ts",
        ".pi/extensions/grill-me/questions.ts",
