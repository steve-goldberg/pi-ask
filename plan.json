          "goal": "Bundle a sensible default design-grilling questionnaire so /grill-me works with zero arguments and no external files.",
          "files": [
            ".pi/extensions/grill-me/questions.ts",
            "tests/unit/grill-me-questions.test.ts"
          ]
        },
        {
          "id": "G004",
          "title": "Build one-question-at-a-time TUI flow",
          "status": "planned",
          "dependsOn": [
            "G001",
            "G002",
            "G003"
          ],
          "goal": "Render question entry, progress indicator, answer editing, and review navigation in a simple native-feeling pi custom UI.",
          "files": [
            ".pi/extensions/grill-me/ui.ts",
            ".pi/extensions/grill-me/questionnaire.ts",
            "tests/unit/grill-me-ui-state.test.ts"
          ],
          "acceptanceNotes": [
            "Question screen shows title, question number, progress, current question, optional recommendation, and answer input",
            "Review screen uses up/down navigation and Enter-to-edit for a selected answer",
            "Review screen also includes selectable Submit and Cancel actions"
          ]
        },
        {
          "id": "G005",
          "title": "Register /grill-me and submit results back into session",
          "status": "planned",
          "dependsOn": [
            "G002",
            "G003",
            "G004"
          ],
          "goal": "Expose the command, launch the questionnaire, and on submit send a wrapped JSON result back into the active pi conversation as a normal user message.",
          "files": [
            ".pi/extensions/grill-me/index.ts",
            "tests/integration/grill-me-command.test.ts",
            "tests/integration/grill-me-submit.test.ts"
          ]
        },
        {
          "id": "G006",
          "title": "Stabilize a reusable questionnaire API for future planning workflows",
          "status": "planned",
          "dependsOn": [
            "G005"
          ],
          "goal": "Keep the questionnaire runner generic so part 2 can supply generated per-feature questions without rewriting the UI or storage logic.",
          "files": [
            ".pi/extensions/grill-me/questionnaire.ts",
            ".pi/extensions/grill-me/types.ts",
            "tests/unit/grill-me-types.test.ts"
          ]
        }
      ],
      "part2Preview": {
        "title": "Feature clarification planner integration",
        "status": "future",
        "goal": "Generate or assemble feature-specific clarification questions, collect answers through the same questionnaire engine, then write those clarifications back into PRD.md and per-feature markdown so spec generation becomes stronger and more grounded.",
        "plannedOutputs": [
          "updated PRD.md sections",
          "updated per-feature 001-name.md files with clarification context",
          "structured Q/A payloads reusable by planning tools"
        ]
      }
    }
  },
