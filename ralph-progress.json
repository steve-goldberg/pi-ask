{
  "schemaVersion": 1,
  "name": "pi-ralph",
  "description": "Pi-native Ralph-style feature loop implemented as a project-local pi extension with a long-lived controller, fresh coder attempts, and read-only testers.",
  "roles": {
    "coder": {
      "prompt": ".pi/ralph/prompts/coder.md",
      "mode": "write",
      "description": "Fresh coding worker. Can edit code but cannot run acceptance gates or mark pass/fail."
    },
    "backendTester": {
      "prompt": ".pi/ralph/prompts/tester-backend.md",
      "mode": "read-only",
      "description": "Read-only tester for non-browser verification and feature-specific backend/product behavior checks."
    },
    "playwrightTester": {
      "prompt": ".pi/ralph/prompts/tester-playwright.md",
      "mode": "read-only",
      "skills": [
        "playwright-cli"
      ],
      "description": "Read-only browser tester for end-to-end and UI acceptance checks."
    }
  },
  "testTypes": {
    "lint": {
      "runner": "command",
      "command": "npm run lint",
      "description": "Static lint gate."
    },
    "typecheck": {
      "runner": "command",
      "command": "npm run typecheck",
      "description": "TypeScript compile/type gate."
    },
    "unit": {
      "runner": "command",
      "command": "npm run test:unit",
      "description": "Unit-test gate."
    },
    "backend": {
      "runner": "agent",
      "role": "backendTester",
      "description": "Read-only tester driven by a feature-specific backend/product test spec."
    },
    "playwright": {
      "runner": "agent",
      "role": "playwrightTester",
      "description": "Read-only browser tester driven by a feature-specific Playwright/e2e test spec."
    }
  },
